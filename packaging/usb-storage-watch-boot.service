[Unit]
Description=USB Storage Watch opt-in container startup after boot
After=local-fs.target docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I /usr/lib/usb-storage-watch/boot_start.py
TimeoutStartSec=180
TimeoutStopSec=25
KillMode=control-group
UMask=0077
LimitCORE=0
StateDirectory=usb-storage-watch
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_SYS_RAWIO
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
PrivateMounts=no
